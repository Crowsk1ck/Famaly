{
  "name": "grizzly-family-panel",
  "version": "17.2.0",
  "private": true,
  "type": "module",
  "description": "Grizzly GTA 5 RP — public website and secure Cloudflare D1 management panel",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply grizzly-db --local --persist-to .wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply grizzly-db --remote",
    "test": "node --test tests/*.test.js",
    "build:social": "node scripts/build-social-preview.mjs",
    "predeploy": "npm run build:social",
    "check:perf": "node scripts/check-performance-budget.mjs",
    "check:backup": "bash scripts/check-backup-roundtrip.sh",
    "check:production": "node scripts/check-production-readiness.mjs",
    "check:backup-freshness": "node scripts/check-backup-freshness.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.47.0",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=20"
  }
}
