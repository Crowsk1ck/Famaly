{
  "name": "grizzly-family-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Grizzly GTA 5 RP — public website and secure Cloudflare D1 management panel",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply grizzly-db --local --persist-to .wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply grizzly-db --remote",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {"wrangler": "^4.47.0"},
  "engines": {"node": ">=20"}
}
